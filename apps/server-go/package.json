{
  "name": "@tgb-resolver/server-go",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "wire ./... && CGO_ENABLED=0 go build -trimpath -ldflags=\"-s -w\" -o dist/server . && go run . --dump-openapi openapi.yaml",
    "dev": "go run .",
    "serve": "CGO_ENABLED=0 go build -trimpath -ldflags=\"-s -w\" -o dist/server . && ./dist/server",
    "preview": "CGO_ENABLED=0 go build -trimpath -ldflags=\"-s -w\" -o dist/server . && ./dist/server",
    "test": "go test ./...",
    "check-types": "go vet ./...",
    "generate": "buf generate && wire ./..."
  }
}
