{
  "name": "@tgb-resolver/web",
  "version": "1.0.0",
  "description": "Web frontend for The Gifted Battlefield resolver",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "dev": "vite dev --port 3000",
