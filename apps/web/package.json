    "prepare": "panda codegen",
    "preview": "vite preview",
    "serve": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:unit": "vitest",
    "type-check": "vue-tsc --build"
  },
