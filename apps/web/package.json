{
  "name": "@tgb-resolver/web",
  "version": "1.0.0",
  "description": "Web frontend for The Gifted Battlefield resolver",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "run-s type-check generate:build build-only",
