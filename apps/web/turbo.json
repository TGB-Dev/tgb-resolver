{
  "$schema": "https://v2-10-9.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "dependsOn": ["^generate"],
      "outputs": ["styled-system/**"]
    },
    "build": {
      "dependsOn": ["generate", "^build", "^generate"],
      "inputs": ["$TURBO_DEFAULT$", "./src/**", "./panda.config.ts", "./styled-system/**"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["generate", "^build", "^check-types"]
    },
    "test": {
      "dependsOn": ["generate", "^build", "^test"],
      "outputs": []
    }
  }
}
