<wpf:ResourceDictionary xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:s="clr-namespace:System;assembly=mscorlib"
                        xmlns:wpf="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xml:space="preserve">
  <!-- ReSharper CLI inspection baseline for this solution.
       Consumed by apps/server/scripts/run-inspect.py via `jb inspectcode --settings`. -->

  <!-- False positives for System.IO.Compression types, which are IDisposable-only
       and have no async disposal / async overload in .NET. -->
  <s:String
    x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/UseAwaitUsing/@EntryIndexedValue">DO_NOT_SHOW</s:String>
  <s:String
    x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/MethodHasAsyncOverloadWithCancellation/@EntryIndexedValue">DO_NOT_SHOW</s:String>

  <!-- Public / contract surface (hub receiver methods, wire-contract enums,
       FluentValidation extensions) that is intentionally unused within the
       solution but consumed by clients or via reflection. -->
  <s:String
    x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/UnusedMember.Global/@EntryIndexedValue">DO_NOT_SHOW</s:String>
  <s:String
    x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/UnusedType.Global/@EntryIndexedValue">DO_NOT_SHOW</s:String>
  <s:String
    x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/UnusedMemberInSuper.Global/@EntryIndexedValue">DO_NOT_SHOW</s:String>
  <s:String
    x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/UnusedMethodReturnValue.Global/@EntryIndexedValue">DO_NOT_SHOW</s:String>
</wpf:ResourceDictionary>
