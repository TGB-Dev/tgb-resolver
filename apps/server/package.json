{
  "name": "@tgb-resolver/server",
  "version": "1.0.0",
  "description": "Server for The Gifted Battlefield OJ resolver",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --minify",
    "check-types": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "serve": "dotenv -v NODE_ENV=production -- node dist/index.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@elysia/cors": "^1.4.2",
    "@elysia/node": "^1.4.6",
    "@sinclair/typebox": "^0.34.49",
    "@tgb-resolver/contracts": "workspace:*",
    "@tgb-resolver/icpc-xml-parser": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "elysia": "^1.4.29",
    "openapi-types": "^12.1.3",
    "tar-stream": "^3.2.0",
    "xxhash-addon": "^2.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.1",
    "@types/tar-stream": "^3.1.4",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  },
  "keywords": []
}
