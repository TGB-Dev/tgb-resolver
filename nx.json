{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "tui": {
    "autoExit": true
  },
  "namedInputs": {
    "sharedGlobals": [
      {
        "env": "VITE_SERVER_URL"
      }
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["{projectRoot}/**/*", "{projectRoot}/.env*"],
      "outputs": [
        "{projectRoot}/dist/**",
        "{projectRoot}/.next/**",
        "!{projectRoot}/.next/cache/**",
        "{projectRoot}/.output/**"
      ],
      "cache": true
    },
    "serve": {
      "cache": false,
      "continuous": true
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "continuous": true
    },
    "preview": {
      "cache": false,
      "continuous": true
    },
    "test": {
      "dependsOn": ["^build", "^test"],
      "cache": true
    }
  },
  "analytics": false
}
