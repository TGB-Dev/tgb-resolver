{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "root": true,
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noUselessFragments": "off"
      },
      "style": {
        "useVueHyphenatedAttributes": "off",
        "useVueMultiWordComponentNames": {
          "level": "on",
          "options": {
            "ignores": [
              "Tooltip",
              "Toaster",
              "Leaderboard",
              "Button",
              "Heading",
              "Spinner",
              "Control",
              "Index",
              "[...path]"
            ]
          }
        }
      }
    }
  },
  "formatter": {
    "lineWidth": 100,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              "react-scan",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/.nx",
      "!!**/.output",
      "!!**/node_modules",
      "!!**/bin",
      "!!**/obj",
      "!!**/TypedSignalR.Client",
      "!!**/*.gen.ts",
      "!!**/TestResults",
      "!!**/gen",
      "!!**/styled-system",
      "!!**/playwright-report",
      "!!**/typed-router.d.ts",
      "vite.config.ts"
    ]
  },
  "html": {
    "experimentalFullSupportEnabled": true
  }
}
