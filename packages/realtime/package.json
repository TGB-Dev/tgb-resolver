{
  "name": "@tgb-resolver/realtime",
  "version": "1.0.0",
  "description": "Realtime and shared client-side domain models for TGB Resolver",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev": "tsdown --watch --no-clean",
    "generate": "pnpm --filter @tgb-resolver/server run generate:proto",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm run check-types"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@tgb-resolver/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "files": [
    "dist"
  ]
}
