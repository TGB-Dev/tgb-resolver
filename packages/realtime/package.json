    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm run check-types"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsdown": "^0.22.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  },
  "files": [
    "dist"
  ]
}
