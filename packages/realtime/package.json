{
  "name": "@tgb-resolver/realtime",
  "version": "1.0.0",
  "description": "Realtime and shared client-side domain models for TGB Resolver",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./signalr": "./dist/signalr.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev": "tsdown --watch --no-clean",
    "generate": "pnpm --filter @tgb-resolver/server exec dotnet tool run dotnet-tsrts --project TGB.Resolver.Server/TGB.Resolver.Server.csproj --output ../../packages/realtime/src/gen --serializer MessagePack --naming-style none --enum name --asm",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm run check-types"
  },
  "dependencies": {
    "@tgb-resolver/contracts": "workspace:*"
  },
  "devDependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@tgb-resolver/server": "workspace:*",
    "@types/node": "^26.3.0",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@microsoft/signalr": "^10.0.11"
  },
  "files": [
    "dist"
  ]
}
