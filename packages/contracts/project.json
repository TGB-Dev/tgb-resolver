{
  "name": "@tgb-resolver/contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "packages/contracts",
  "sourceRoot": "packages/contracts/src",
  "projectType": "library",
  "implicitDependencies": ["server"],
  "targets": {
    "build": {
      "command": "pnpm --filter @tgb-resolver/contracts run build",
      "dependsOn": ["server:openapi", "^build"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/src/generated"]
    },
    "generate": {
      "command": "pnpm --filter @tgb-resolver/contracts run generate",
      "dependsOn": ["server:openapi"],
      "outputs": ["{projectRoot}/src/generated"]
    }
  }
}
