{
  "name": "@tgb-resolver/contracts",
  "version": "1.0.0",
  "description": "Contracts for The Gifted Battlefield resolver",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev": "tsdown --watch --no-clean",
    "generate": "openapi-ts",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm run check-types"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.3",
    "ofetch": "^1.5.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tgb-resolver/server": "workspace:*",
    "@types/node": "^26.1.1",
    "bumpp": "^12.0.0",
    "tsdown": "^0.22.12",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist"
  ]
}
