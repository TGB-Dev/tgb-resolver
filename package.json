{
  "name": "tgb-resolver",
  "description": "The Gifted Battlefield OJ resolver, compatible with DMOJ-exported ICPC XML format.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "biome check . --write",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "format": "turbo run format",
    "generate": "turbo run generate",
    "hooks:install": "git config core.hooksPath .githooks",
    "knip": "knip",
    "lint": "biome lint . --write",
    "prepare": "husky",
    "preview": "turbo run preview",
    "serve": "turbo run serve",
    "sync": "pnpm syncpack fix --dependency-types prod,dev,peer && pnpm syncpack format",
    "sync:check": "pnpm syncpack lint --dependency-types prod,dev,peer",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.2",
    "husky": "^9.1.7",
    "knip": "^6.37.0",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.2",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.1.3"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
