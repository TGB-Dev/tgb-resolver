{
  "name": "tgb-resolver",
  "description": "The Gifted Battlefield OJ resolver, compatible with DMOJ-exported ICPC XML format.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "biome check . --write",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "format": "turbo run format",
    "generate": "turbo run generate",
    "hooks:install": "git config core.hooksPath .githooks",
    "knip": "knip",
    "lint": "biome lint . --write",
    "prepare": "husky",
    "preview": "turbo run preview",
    "serve": "turbo run serve",
    "sync": "pnpm syncpack fix --dependency-types prod,dev,peer && pnpm syncpack format",
    "sync:check": "pnpm syncpack lint --dependency-types prod,dev,peer",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.3",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.5",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.1.3"
  },
  "packageManager": "pnpm@12.7.0+sha512.9c56477e360068d6e9dca6a92efb4e46b3dc5a52fcebf3d84d78b9736c0ded589a561621a52f68219a7a39facc63cdc079c3226ef9c9d5f02b79f74e69a807b6"
}
