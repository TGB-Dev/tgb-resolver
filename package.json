{
  "name": "tgb-resolver",
  "description": "The Gifted Battlefield OJ resolver, compatible with DMOJ-exported ICPC XML format.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "biome check . --write",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "format": "biome format . --write",
    "generate": "turbo run generate",
    "hooks:install": "git config core.hooksPath .githooks",
    "knip": "knip",
    "lint": "biome lint . --write",
    "nuget:outdated": "turbo run nuget:outdated --filter=@tgb-resolver/server",
    "nuget:update": "turbo run nuget:update --filter=@tgb-resolver/server",
    "preview": "turbo run preview",
    "quality": "turbo run quality --filter=@tgb-resolver/server",
    "serve": "turbo run serve",
    "sync": "pnpm syncpack fix --dependency-types prod,dev,peer && pnpm syncpack format",
    "sync:check": "pnpm syncpack lint --dependency-types prod,dev,peer",
    "test": "turbo run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.1.2",
    "husky": "^9.1.7",
    "knip": "^6.31.0",
    "syncpack": "^15.3.2",
    "turbo": "^2.10.8",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.1.3"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
