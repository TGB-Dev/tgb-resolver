{
  "name": "tgb-resolver",
  "description": "The Gifted Battlefield OJ resolver, compatible with DMOJ-exported ICPC XML format.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "biome check . --write",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "format": "biome format . --write",
    "lint": "biome lint . --write",
    "prepare": "husky",
    "serve": "turbo run serve",
    "sync": "pnpm syncpack fix --dependency-types prod,dev,peer && pnpm syncpack format",
    "sync:check": "pnpm syncpack lint --dependency-types prod,dev,peer",
    "test": "turbo run test"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/node": "^26.0.0",
    "husky": "^9.1.7",
    "rimraf": "^6.1.3",
    "syncpack": "^15.3.2",
    "tsx": "^4.22.4",
    "turbo": "^2.9.18",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.1.3"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
