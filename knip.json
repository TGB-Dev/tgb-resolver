{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["**/*.gen.ts", "**/src/generated/**", "**/src/proto/gen/**"],
  "workspaces": {
    ".": {
      "entry": ["*.json", "vitest.workspace.ts"],
      "vitest": {
        "config": []
      }
    },
    "apps/web": {
      "entry": ["index.html"],
      "ignore": ["src/lib/api.ts", "src/lib/realtime-client.ts"],
      "ignoreIssues": {
        "src/features/extensions/base/types.ts": ["types"],
        "src/features/extensions/base/registry.ts": ["exports"],
        "src/features/extensions/confetti/presets.ts": ["types"],
        "src/lib/sound-engine/index.ts": ["exports"],
        "src/utils/preload-assets.ts": ["exports"]
      },
      "ignoreDependencies": ["@pandacss/plugin-lightningcss", "browserslist", "lightningcss"]
    },
    "apps/server": {
      "ignoreBinaries": ["go"],
      "ignoreDependencies": ["@bufbuild/protoc-gen-es"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts"]
    },
    "packages/realtime": {}
  }
}
